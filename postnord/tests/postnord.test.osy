[Test]
void a_pickup_asks_postnord_to_come_to_the_shop_on_the_day() {
  var urls = new List<string>();
  var posted = new List<string>();
  Http.Post.Stub((url, body) => {
    urls.Add(url); posted.Add(body);
    return new HttpResponse { StatusCode = 201, Body = "{\"bookingResponse\":{\"bookingId\":\"PICK-77\",\"idInformation\":[]}}" };
  });
  var booked = Carrier().BookPickup(new PickupRequest { Reference = "AV-PICKUP-20261001", Date = new DateOnly(2026, 10, 1),
                                                        Parcels = 3, WeightGrams = 2500, TrackingNumbers = ["00370000000000000001"] });
  Assert.Equal("PICK-77", booked!.Reference);
  Assert.StartsWith("https://atapi2.postnord.com/rest/shipment/v3/pickups?apikey=k", urls[0]);
  Assert.Contains("\"earliestPickupDate\":\"2026-10-01T09:00:00Z\"", posted[0]);
  Assert.Contains("\"numberOfPackages\":{\"value\":3}", posted[0]);
  Assert.Contains("\"pickupParty\":{\"party\":{\"nameIdentification\":{\"name\":\"Shop\"}", posted[0]);
  Assert.Contains("\"itemId\":\"00370000000000000001\"", posted[0]);
}

[Test]
void a_parcel_with_an_age_limit_is_booked_with_postnords_age_check_and_the_age_on_the_parcel() {
  var posted = new List<string>();
  Http.Post.Stub((url, body) => {
    posted.Add(body);
    return new HttpResponse { StatusCode = 200, Body = "{\"bookingResponse\":{\"bookingId\":\"B5\",\"idInformation\":[]},\"labelPrintout\":[]}" };
  });
  var to = new DeliveryAddress { Name = "Maja Berg", Street = "Hornsgatan 64", PostCode = "11821", City = "Stockholm", Country = "SE" };
  // Wine for Swedish retail: 20. PostNord's D8 (Age Check), and the age as the parcel's ZAG reference.
  Carrier().Ship(new ShipmentRequest { Reference = "GG-20", OptionId = "collect", WeightGrams = 1500, To = to, MinimumAge = 20 });
  Assert.Contains("\"service\":{\"basicServiceCode\":\"19\",\"additionalServiceCode\":[\"D8\"]}", posted[0]);
  Assert.Contains("\"grossWeight\":{\"value\":1.500,\"unit\":\"KGM\"},\"references\":[{\"referenceNo\":\"20\",\"referenceType\":\"ZAG\"}]}", posted[0]);
  // An age PostNord does not list is booked at the next one up: 17 → 18.
  Carrier().Ship(new ShipmentRequest { Reference = "GG-17", OptionId = "home", To = to, MinimumAge = 17 });
  Assert.Contains("\"basicServiceCode\":\"17\",\"additionalServiceCode\":[\"D8\"]", posted[1]);
  Assert.Contains("{\"referenceNo\":\"18\",\"referenceType\":\"ZAG\"}", posted[1]);
  // No limit: no age check, no age.
  Carrier().Ship(new ShipmentRequest { Reference = "GG-0", OptionId = "home", To = to });
  Assert.Contains("\"additionalServiceCode\":[]", posted[2]);
  Assert.DoesNotContain("ZAG", posted[2]);
}

[Test]
void an_age_limited_parcel_postnord_cannot_check_is_refused_and_nothing_is_booked() {
  var posted = new List<string>();
  Http.Post.Stub((url, body) => { posted.Add(body); return new HttpResponse { StatusCode = 200, Body = "{}" }; });
  // PostNord checks age only on parcels delivered in Sweden…
  var oslo = new DeliveryAddress { Name = "Ola Nordmann", Street = "Karl Johans gate 1", PostCode = "0154", City = "Oslo", Country = "NO" };
  var abroad = Assert.Throws<ExternalServiceException>(() => Carrier().Ship(new ShipmentRequest { Reference = "GG-NO",
    OptionId = "home", To = oslo, MinimumAge = 18 }));
  Assert.Contains("18 or older", abroad.Message);
  Assert.Contains("only on parcels delivered in Sweden", abroad.Message);
  // …asks for 20 at most…
  var stockholm = new DeliveryAddress { Name = "Maja Berg", Street = "Storgatan 1", PostCode = "11122", City = "Stockholm", Country = "SE" };
  var older = Assert.Throws<ExternalServiceException>(() => Carrier().Ship(new ShipmentRequest { Reference = "GG-21",
    OptionId = "home", To = stockholm, MinimumAge = 21 }));
  Assert.Contains("16, 18 or 20 at most", older.Message);
  // …and is booked on a Swedish customer number.
  var norwegian = Carrier();
  norwegian.IssuerCode = "Z13";
  var issuer = Assert.Throws<ExternalServiceException>(() => norwegian.Ship(new ShipmentRequest { Reference = "GG-Z13",
    OptionId = "collect", To = stockholm, MinimumAge = 18 }));
  Assert.Contains("Swedish customer number (Z12)", issuer.Message);
  Assert.Empty(posted);
  // The client on its own refuses an age PostNord does not take.
  var client = new PostNordClient { ApiKey = "k", CustomerNumber = "1" };
  var odd = Assert.Throws<ExternalServiceException>(() => client.Book(new PostNordBooking { Reference = "X", AgeCheck = 19 }));
  Assert.Contains("16, 18 or 20", odd.Message);
  Assert.Empty(posted);
}
