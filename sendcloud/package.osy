// Osysharp.Carriers.Sendcloud — many European carriers behind one integration (DHL, DPD, GLS, UPS, PostNL, Colissimo…),
// through Sendcloud's API v3.
//
// Two layers. `model/api/` is Sendcloud's API as its own OpenAPI specs describe it — GENERATED with
// `osy import-api` from https://sendcloud.dev/.openapi/v3/<area>/openapi.yaml, one namespace per area, and ordinary
// source from then on. `SendcloudDelivery` is Sendcloud as a delivery provider under the `Osysharp.Delivery` contract.
//
// ⚑ API v3, NOT v2. Sendcloud's v2 parcel API is in maintenance, and an account created after April 2026 cannot use it.
// ⚑ AUTHENTICATION IS HTTP BASIC — the public key and the secret key from the Sendcloud panel. There is no sandbox:
//   a test label is the `sendcloud:letter` option (free), which is what `Test = true` ships with.
package Osysharp.Carriers.Sendcloud {
  version "0.1.1";
  minPlatform "0.9.0";
  summary     "Sendcloud — many European carriers behind one API: labels, customs, tracking, returns, pickups, and a delivery provider.";
  model "model/**/*.osy";
  use Osysharp.Http;
  use Osysharp.Delivery@0;
  egress "panel.sendcloud.sc";
  tests "tests";
}
