namespace Osysharp.Carriers.Shippo;

using Osysharp.Delivery;

/// One way to deliver the shop offers through Shippo: a carrier's service level, at the shop's price.
public class ShippoOption {
  /// The shop's own id for it ("usps-priority").
  public string Id = "";
  public string Label = "";
  public string Description = "";
  /// Shippo's carrier account id (from the Shippo dashboard) and its service level token ("usps_priority").
  public string CarrierAccount = "";
  public string ServiceLevel = "";
  /// Shippo's carrier token ("usps", "ups", "fedex") — what tracking asks by.
  public string Carrier = "";
  /// Minor units, what the customer pays.
  public long Price = 0;
  /// ISO 3166 alpha-2 codes it goes to. Empty: anywhere.
  public List<string> Countries = [];
  public int? DaysMin;
  public int? DaysMax;
}

/// Shippo as a way to deliver, under the `Osysharp.Delivery` contract: the shop's options at the shop's prices; sending an
/// order buys the label in one call (the shipment inline, the carrier account and service level named) and answers the
/// tracking number, link and PDF; a parcel leaving the country carries its customs declaration; returns are labels
/// Shippo turns around.
///
///     new ShippoDelivery { ApiKey = Secret.ShippoApiKey,
///                          Sender = new DeliveryAddress { Name = "…", Street = "…", PostCode = "…", City = "…", Country = "US" },
///                          Options = [ new ShippoOption { Id = "usps-priority", Label = "USPS Priority", CarrierAccount = "…",
///                                                         ServiceLevel = "usps_priority", Carrier = "usps", Price = 899 } ] }
public class ShippoDelivery : IDeliveryProvider {
  public string Key { get; set; } = "shippo";
  public string Name { get; set; } = "Shippo";
  public string ApiKey = "";
  /// Who the parcels come from; for a US sender, `State` goes in `Region`.
  public DeliveryAddress Sender = new DeliveryAddress();
  /// The sender's two-letter state or province, which US carriers require.
  public string SenderRegion = "";
  public List<ShippoOption> Options = [];
  /// Minor units; every option is free from this subtotal up. Zero: never free.
  public long FreeFrom = 0;
  /// Who signs a customs declaration (a person's name).
  public string CustomsSigner = "";

  public bool IsReady() { return ApiKey != "" && Options.Count > 0; }

  public List<DeliveryOption> Quote(DeliveryQuoteRequest request) {
    var free = FreeFrom > 0 && request.Subtotal >= FreeFrom;
    var country = request.To == null ? "" : request.To.Country.ToUpper();
    return Options.Where(o => country == "" || o.Countries.Count == 0 || o.Countries.Contains(country))
      .Select(o => new DeliveryOption { Id = o.Id, Label = o.Label, Description = o.Description, Price = free ? 0 : o.Price,
                                        NeedsAddress = true, DaysMin = o.DaysMin, DaysMax = o.DaysMax }).ToList();
  }

  /// None: Shippo's API (the transactions and tracking specs this kit is generated from) has no pickup-point search
  /// and no way to address a label to one — every option goes to the customer's address.
  public List<PickupPoint> PickupPoints(string optionId, DeliveryAddress near) { return []; }

  public Shipment Ship(ShipmentRequest request) {
    var option = Options.FirstOrDefault(o => o.Id == request.OptionId);
    if (option == null) { throw new ExternalServiceException($"Shippo has no option '{request.OptionId}' in this shop's list."); }
    return Osysharp.Carriers.Shippo.Transactions.BuyLabel(ApiKey, option.CarrierAccount, option.ServiceLevel, request.SendFrom ?? Sender, SenderRegion, request.To,
      request.WeightGrams, request.Customs, request.ExporterId, CustomsSigner, request.Reference, false, request.MinimumAge);
  }

  /// A return label: the original parcel's route turned round by Shippo (`is_return`), on the first option's service.
  public ReturnShipment? BookReturn(ReturnShipmentRequest request) {
    var option = Options.FirstOrDefault(o => o.Id == request.OriginalOptionId) ?? Options.FirstOrDefault();
    if (option == null) { return null; }
    var s = Osysharp.Carriers.Shippo.Transactions.BuyLabel(ApiKey, option.CarrierAccount, option.ServiceLevel, Sender, SenderRegion, request.From,
      request.WeightGrams, [], "", CustomsSigner, request.Reference, true);
    return new ReturnShipment { TrackingNumber = s.TrackingNumber, TrackingUrl = s.TrackingUrl, Label = s.Label };
  }

  /// Shippo's pickups need the label TRANSACTIONS they are for, which the delivery contract does not carry — not offered.
  public bool MakesLabels() { return true; }

  public bool BooksPickups() { return false; }
  public PickupBooking? BookPickup(PickupRequest request) { return null; }

  /// Tracking asks by carrier and number; the carrier is not on the parcel, so each carrier the shop sends with is asked
  /// until one knows it.
  public Osysharp.Delivery.TrackingStatus Track(string trackingNumber) {
    var last = new Osysharp.Delivery.TrackingStatus { State = DeliveryState.Booked };
    foreach (var carrier in Options.Select(o => o.Carrier).Where(c => c != "").Distinct().ToList()) {
      var status = Osysharp.Carriers.Shippo.Tracking.TrackWithShippo(ApiKey, carrier, trackingNumber);
      if (status != null) { return status; }
    }
    return last;
  }

  /// Shippo's webhooks carry no signature the shop could check — delivery is asked instead (the order's carrier poll).
  public List<DeliveryEvent> HandleEvent(string body, Dictionary<string, string> headers) {
    throw new ExternalServiceException("Shippo's events are not admitted here: they carry no signature. The shop asks `Track` instead.");
  }
}

/// Shippo's `tracking_status.status`, in the contract's words.
public DeliveryState ShippoState(string status) {
  if (status == "DELIVERED") { return DeliveryState.Delivered; }
  if (status == "TRANSIT") { return DeliveryState.InTransit; }
  if (status == "RETURNED") { return DeliveryState.Returned; }
  if (status == "FAILURE") { return DeliveryState.Exception; }
  return DeliveryState.Booked;   // PRE_TRANSIT, UNKNOWN
}
